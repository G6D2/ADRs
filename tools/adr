#!/usr/bin/env bash
#
# adr — herramienta de gestión de Architecture Decision Records (ADRs)
#
# Sigue los lineamientos de https://github.com/G6D2/architecture-decision-record:
#   - Plantilla estilo Michael Nygard (Contexto / Decisión / Consecuencias)
#   - Nombres de archivo: frase verbal en imperativo, minúsculas-con-guiones
#   - Estados: propuesta, aceptada, rechazada, obsoleta, reemplazada
#   - Inmutabilidad: un ADR aceptado no se edita, se reemplaza con uno nuevo
#
# Uso: tools/adr <comando> [argumentos]   (ejecutar desde la raíz del repo)

set -euo pipefail

ADR_DIR="${ADR_DIR:-adr}"
TEMPLATE="${ADR_TEMPLATE:-$ADR_DIR/templates/plantilla.md}"
INDEX_FILE="$ADR_DIR/README.md"
VALID_STATUSES="propuesta aceptada rechazada obsoleta reemplazada"

usage() {
  cat <<'EOF'
adr — gestión de Architecture Decision Records

Comandos:
  new <título>                Crea un ADR nuevo a partir de la plantilla.
                              El título debe ser una frase verbal en imperativo,
                              p. ej.: "elegir base de datos".
  list                        Lista los ADRs con su estado y fecha.
  index                       Regenera el índice (adr/README.md).
  status <archivo> <estado>   Cambia el estado de un ADR y lo registra en su
                              historial. Estados: propuesta | aceptada |
                              rechazada | obsoleta | reemplazada
  supersede <archivo> <título>  Crea un ADR nuevo que reemplaza a uno existente
                              y enlaza ambos documentos.
  lint                        Valida que todos los ADRs cumplan la convención
                              (secciones requeridas, estado y fecha válidos).
  help                        Muestra esta ayuda.

Variables de entorno:
  ADR_DIR       Directorio de ADRs (por defecto: adr)
  ADR_TEMPLATE  Plantilla a usar (por defecto: adr/templates/plantilla.md)
EOF
}

die() { echo "error: $*" >&2; exit 1; }

today() { date +%Y-%m-%d; }

slugify() {
  # "Elegir Base de Datos" -> "elegir-base-de-datos"
  printf '%s' "$1" \
    | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

adr_files() {
  find "$ADR_DIR" -maxdepth 1 -name '*.md' ! -name 'README.md' | sort
}

# Extrae el valor de un campo de metadatos ("- Estado: aceptada" -> "aceptada")
field() { # $1=archivo $2=campo
  sed -nE "s/^- $2:[[:space:]]*//p" "$1" | head -n1
}

title_of() { sed -nE 's/^# +//p' "$1" | head -n1; }

is_valid_status() {
  local s
  for s in $VALID_STATUSES; do
    if [ "$1" = "$s" ]; then return 0; fi
  done
  return 1
}

resolve_file() { # nombre o ruta -> ruta existente
  if [ -f "$1" ]; then
    printf '%s' "$1"
  elif [ -f "$ADR_DIR/$1" ]; then
    printf '%s' "$ADR_DIR/$1"
  elif [ -f "$ADR_DIR/$1.md" ]; then
    printf '%s' "$ADR_DIR/$1.md"
  else
    return 1
  fi
}

new_from_template() { # $1=título $2=archivo destino
  sed -e "s/{{TITULO}}/$1/" -e "s/{{FECHA}}/$(today)/" "$TEMPLATE" > "$2"
}

cmd_new() {
  if [ $# -lt 1 ]; then die "uso: adr new <título>"; fi
  local title="$*"
  local slug; slug=$(slugify "$title")
  if [ -z "$slug" ]; then die "el título no genera un nombre de archivo válido"; fi
  local file="$ADR_DIR/$slug.md"
  if [ -e "$file" ]; then die "ya existe $file"; fi
  if [ ! -f "$TEMPLATE" ]; then die "no se encuentra la plantilla $TEMPLATE"; fi

  new_from_template "$title" "$file"
  echo "creado: $file"
  cmd_index
}

cmd_list() {
  local f
  printf '%-45s %-12s %-11s %s\n' "ARCHIVO" "ESTADO" "FECHA" "TÍTULO"
  for f in $(adr_files); do
    printf '%-45s %-12s %-11s %s\n' \
      "$(basename "$f")" \
      "$(field "$f" Estado)" \
      "$(field "$f" Fecha)" \
      "$(title_of "$f")"
  done
}

cmd_index() {
  local f
  {
    echo "# Registro de decisiones de arquitectura"
    echo
    echo "Índice generado automáticamente — no editar a mano."
    echo "Para regenerarlo: \`tools/adr index\`"
    echo
    echo "| ADR | Estado | Fecha |"
    echo "|-----|--------|-------|"
    for f in $(adr_files); do
      echo "| [$(title_of "$f")]($(basename "$f")) | $(field "$f" Estado) | $(field "$f" Fecha) |"
    done
    echo
    echo "Para crear un ADR nuevo: \`tools/adr new \"<título>\"\` — ver el"
    echo "[README principal](../README.md) para el flujo de trabajo completo."
  } > "$INDEX_FILE"
  echo "índice regenerado: $INDEX_FILE"
}

set_status() { # $1=archivo $2=estado nuevo
  sed -i -E "s/^- Estado:.*/- Estado: $2/" "$1"
}

log_history() { # $1=archivo $2=entrada
  if grep -q '^## Historial' "$1"; then
    printf -- '- %s: %s\n' "$(today)" "$2" >> "$1"
  fi
}

cmd_status() {
  if [ $# -ne 2 ]; then die "uso: adr status <archivo> <estado>"; fi
  local file
  file=$(resolve_file "$1") || die "no existe el ADR: $1"
  local status="$2"
  is_valid_status "$status" || die "estado inválido: $status (válidos: $VALID_STATUSES)"

  local old; old=$(field "$file" Estado)
  set_status "$file" "$status"
  log_history "$file" "cambio de estado: $old → $status"
  echo "$file: $old → $status"
  cmd_index
}

cmd_supersede() {
  if [ $# -lt 2 ]; then die "uso: adr supersede <archivo> <título del nuevo ADR>"; fi
  local old
  old=$(resolve_file "$1") || die "no existe el ADR: $1"
  shift
  local title="$*"
  local slug; slug=$(slugify "$title")
  if [ -z "$slug" ]; then die "el título no genera un nombre de archivo válido"; fi
  local new="$ADR_DIR/$slug.md"
  if [ -e "$new" ]; then die "ya existe $new"; fi
  if [ ! -f "$TEMPLATE" ]; then die "no se encuentra la plantilla $TEMPLATE"; fi

  local old_title; old_title=$(title_of "$old")
  local old_status; old_status=$(field "$old" Estado)

  new_from_template "$title" "$new"
  sed -i -E "s|^- Reemplaza a:.*|- Reemplaza a: [$old_title]($(basename "$old"))|" "$new"

  set_status "$old" "reemplazada"
  sed -i -E "s|^- Reemplazada por:.*|- Reemplazada por: [$title]($(basename "$new"))|" "$old"
  log_history "$old" "$old_status → reemplazada por [$title]($(basename "$new"))"

  echo "creado: $new (reemplaza a $(basename "$old"))"
  cmd_index
}

cmd_lint() {
  local f errors=0 ok st
  check() { # $1=mensaje
    echo "  ✗ $1"
    errors=$((errors + 1))
    ok=0
  }
  for f in $(adr_files); do
    echo "$f"
    ok=1
    if [ -z "$(title_of "$f")" ]; then check "falta el título (# ...)"; fi
    st=$(field "$f" Estado)
    if [ -z "$st" ]; then
      check "falta el campo '- Estado:'"
    elif ! is_valid_status "$st"; then
      check "estado inválido: '$st' (válidos: $VALID_STATUSES)"
    fi
    if ! field "$f" Fecha | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
      check "falta o es inválido el campo '- Fecha:' (AAAA-MM-DD)"
    fi
    if ! grep -q '^## Contexto' "$f"; then check "falta la sección '## Contexto'"; fi
    if ! grep -q '^## Decisión' "$f"; then check "falta la sección '## Decisión'"; fi
    if ! grep -q '^## Consecuencias' "$f"; then check "falta la sección '## Consecuencias'"; fi
    if grep -q '{{' "$f"; then check "quedan marcadores de plantilla sin completar ({{...}})"; fi
    if [ "$ok" -eq 1 ]; then echo "  ✓ ok"; fi
  done
  echo
  if [ "$errors" -gt 0 ]; then
    echo "lint: $errors problema(s) encontrado(s)" >&2
    exit 1
  fi
  echo "lint: todos los ADRs son válidos"
}

cmd="${1:-help}"
if [ $# -gt 0 ]; then shift; fi
case "$cmd" in
  new)       cmd_new "$@" ;;
  list)      cmd_list "$@" ;;
  index)     cmd_index "$@" ;;
  status)    cmd_status "$@" ;;
  supersede) cmd_supersede "$@" ;;
  lint)      cmd_lint "$@" ;;
  help|-h|--help) usage ;;
  *) die "comando desconocido: $cmd (use 'adr help')" ;;
esac
